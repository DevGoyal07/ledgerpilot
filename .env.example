# LedgerPilot — LLM backend configuration (OPTIONAL)
# Leave everything unset to run in deterministic OFFLINE mode (no key needed).
# Set these to switch on the live LLM backend for the demo.

# Any OpenAI-compatible key (OpenAI, Together, Groq, local vLLM, etc.)
LEDGERPILOT_API_KEY=

# Override the base URL for non-OpenAI providers, e.g.
#   https://api.groq.com/openai/v1
#   http://localhost:8000/v1   (local vLLM / Ollama-openai)
LEDGERPILOT_API_BASE=https://api.openai.com/v1

# Model name as the provider expects it
LEDGERPILOT_MODEL=gpt-4o-mini

# Flask session secret (any random string)
LEDGERPILOT_SECRET=change-me
